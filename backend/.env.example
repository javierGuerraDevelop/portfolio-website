# Copy to .env and fill in real values. Never commit .env.
PORT=8080

# Comma-separated list of allowed frontend origins (CORS).
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

GITHUB_USERNAME=your-github-username

# Optional: without a token the repos endpoint serves fixture data.
GITHUB_TOKEN=

# Contact delivery (Resend). Set all three together, or leave all three empty
# to disable the contact endpoint at runtime.
RESEND_API_KEY=
CONTACT_TO=you@example.com
CONTACT_FROM=portfolio@example.com
